---
import type { DirectionPanel } from "../data/directions";
import DetailPanel from "./DetailPanel.astro";

interface Props {
  panel: DirectionPanel;
}

const { panel } = Astro.props;
---

<div class="detail-page" data-detail-page>
  <DetailPanel {...panel} standalone />
</div>

<script>
  import { gsap } from "gsap";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(SplitText);

  let activeTimeline: gsap.core.Timeline | undefined;
  let activeSplits: SplitText[] = [];

  const cleanupDetailAnimation = () => {
    activeTimeline?.kill();
    activeTimeline = undefined;
    activeSplits.forEach((split) => split.revert());
    activeSplits = [];
  };

  const initialiseDetailAnimation = () => {
    cleanupDetailAnimation();
    const panel = document.querySelector<HTMLElement>("[data-standalone-detail]");
    if (!panel || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const number = panel.querySelector<HTMLElement>("[data-animate-number]");
    const kicker = panel.querySelector<HTMLElement>("[data-split-kicker]");
    const title = panel.querySelector<HTMLElement>("[data-split-title]");
    const image = panel.querySelector<HTMLElement>("[data-animate-image]");
    const lead = panel.querySelector<HTMLElement>("[data-split-lead]");
    const note = panel.querySelector<HTMLElement>("[data-split-note]");
    const capabilities = panel.querySelectorAll<HTMLElement>("[data-animate-capability]");
    const examplesLabel = panel.querySelector<HTMLElement>("[data-animate-examples-label]");
    const examples = panel.querySelectorAll<HTMLElement>("[data-animate-example]");
    const backButton = panel.querySelector<HTMLElement>("[data-detail-back]");
    if (!number || !kicker || !title || !image || !lead || !note) return;

    const kickerSplit = SplitText.create(kicker, { type: "words", wordsClass: "split-word", aria: "auto" });
    const titleSplit = SplitText.create(title, { type: "chars", charsClass: "split-char", aria: "auto" });
    const leadSplit = SplitText.create(lead, {
      type: "lines",
      linesClass: "split-line",
      mask: "lines",
      aria: "auto",
    });
    const noteSplit = SplitText.create(note, { type: "words", wordsClass: "split-word", aria: "auto" });
    activeSplits = [kickerSplit, titleSplit, leadSplit, noteSplit];

    activeTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
    activeTimeline
      .from(number, { opacity: 0, scale: 0.35, rotation: -24, duration: 0.65, ease: "back.out(1.8)" }, 0)
      .from(backButton, { opacity: 0, scale: 0.65, x: 14, duration: 0.5 }, 0.08)
      .from(kickerSplit.words, { opacity: 0, x: -18, duration: 0.5, stagger: 0.045 }, 0.12)
      .from(
        titleSplit.chars,
        {
          opacity: 0,
          yPercent: 115,
          rotationX: -90,
          transformOrigin: "50% 100%",
          transformPerspective: 700,
          duration: 0.72,
          stagger: { each: 0.028, from: "edges" },
          ease: "back.out(1.45)",
        },
        0.22,
      )
      .from(
        image,
        {
          opacity: 0.2,
          scale: 1.12,
          clipPath: "inset(8% 48% 8% 48% round 18px)",
          filter: "blur(12px)",
          duration: 1.05,
          ease: "expo.out",
        },
        0.25,
      )
      .from(leadSplit.lines, { opacity: 0, yPercent: 120, duration: 0.72, stagger: 0.09 }, 0.58)
      .from(
        noteSplit.words,
        { opacity: 0, y: 12, filter: "blur(5px)", duration: 0.45, stagger: 0.018 },
        0.78,
      )
      .from(
        capabilities,
        { opacity: 0, y: 28, scale: 0.94, duration: 0.58, stagger: 0.08, ease: "back.out(1.35)" },
        1.02,
      )
      .from(examplesLabel, { opacity: 0, x: -16, duration: 0.42 }, 1.18)
      .from(examples, { opacity: 0, x: 18, duration: 0.48, stagger: 0.07 }, 1.22);
    activeTimeline.timeScale(0.5);
  };

  document.addEventListener("astro:page-load", initialiseDetailAnimation);
  document.addEventListener("astro:before-swap", cleanupDetailAnimation);
</script>
