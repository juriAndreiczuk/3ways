---
export type PresentationStage =
  | "intro"
  | "solutions"
  | "canvas"
  | "islands"
  | "mini-spa"
  | "demo";

interface Props {
  current: PresentationStage;
}

const { current } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const stages = [
  { id: "intro", label: "INTRO", href: baseUrl, glyph: "beacon" },
  { id: "solutions", label: "ROZWIĄZANIA", href: baseUrl + "kierunki", glyph: "fork" },
  { id: "canvas", label: "CANVAS", href: baseUrl + "kierunki/canvas", glyph: "crystal" },
  { id: "islands", label: "ISLANDS", href: baseUrl + "kierunki/islands", glyph: "orbit" },
  { id: "mini-spa", label: "MINI SPA", href: baseUrl + "kierunki/web-apps", glyph: "core" },
  { id: "demo", label: "DEMO", href: baseUrl + "demo-configurator", glyph: "portal" },
] as const;
const currentIndex = stages.findIndex((stage) => stage.id === current);
---

<nav class:list={["presentation-route", { "presentation-route--intro": current === "intro" }]} aria-label="Etapy prezentacji" data-presentation-route data-current-stage={current}>
  <p class="presentation-route__caption">MAPA PRZEJŚCIA</p>
  <div class="presentation-route__field">
    <div class="presentation-route__path" aria-hidden="true">
      <span class="presentation-route__path-fill" data-route-fill></span>
      <span class="presentation-route__signal" data-route-signal></span>
    </div>
    <ol class="presentation-route__stages">
      {stages.map((stage, index) => {
        const state =
          index === currentIndex
            ? "current"
            : stage.id === "intro" || stage.id === "solutions"
              ? "complete"
              : "locked";
        const content = <>
          <span class="presentation-route__glyph" aria-hidden="true" data-glyph={stage.glyph}>
            {stage.glyph === "beacon" && <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="5"/><circle cx="24" cy="24" r="13"/><path d="M24 2v8M24 38v8M2 24h8M38 24h8"/></svg>}
            {stage.glyph === "fork" && <svg viewBox="0 0 48 48"><circle cx="24" cy="33" r="4"/><circle cx="11" cy="14" r="3"/><circle cx="24" cy="10" r="3"/><circle cx="37" cy="14" r="3"/><path d="M24 29V20M24 20 11 14M24 20V10M24 20l13-6"/></svg>}
            {stage.glyph === "crystal" && <svg viewBox="0 0 48 48"><rect x="8" y="8" width="32" height="32" rx="3"/><path d="M8 18h32M18 8v32M18 18h12v12H18zM12 12h2M34 34h2"/></svg>}
            {stage.glyph === "orbit" && <svg viewBox="0 0 48 48"><path d="M5 34c5-1 8-7 13-7s8 7 13 7 8-6 12-7"/><path d="M7 39c4-1 7-4 11-4s7 4 12 4 8-4 11-4"/><circle cx="13" cy="18" r="5"/><circle cx="27" cy="12" r="7"/><circle cx="38" cy="22" r="4"/></svg>}
            {stage.glyph === "core" && <svg viewBox="0 0 48 48"><rect x="7" y="7" width="15" height="15" rx="2"/><rect x="26" y="7" width="15" height="15" rx="2"/><rect x="7" y="26" width="15" height="15" rx="2"/><path d="M30 30h7M30 35h7M30 40h7"/></svg>}
            {stage.glyph === "portal" && <svg viewBox="0 0 48 48"><path d="M8 13h32M8 24h32M8 35h32"/><circle cx="17" cy="13" r="4"/><circle cx="31" cy="24" r="4"/><circle cx="23" cy="35" r="4"/><path d="M9 5h30M9 43h30"/></svg>}
          </span>
          <span class="presentation-route__meta">
            <span class="presentation-route__index">{String(index).padStart(2, "0")}</span>
            <span class="presentation-route__label" data-route-label>{state === "locked" ? "···" : stage.label}</span>
          </span>
        </>;
        return <li class:list={["presentation-route__stage", `is-${state}`]} data-stage={stage.id}>
          <a class="presentation-route__node" href={stage.href} aria-current={state === "current" ? "step" : undefined} aria-disabled={state === "locked" ? "true" : undefined} tabindex={state === "locked" ? "-1" : undefined} aria-label={state === "locked" ? `Etap ${index + 1}: jeszcze nieodkryty` : undefined}>{content}</a>
        </li>;
      })}
    </ol>
  </div>
</nav>

<script>
  const revealedDirectionsStorageKey = "interactive-web:revealed-directions";
  const stageOrder = ["intro", "solutions", "canvas", "islands", "mini-spa", "demo"];
  const stageDirectionIds: Record<string, string> = {
    canvas: "canvas",
    islands: "islands",
    "mini-spa": "web-apps",
    demo: "demo-configurator",
  };

  const readRevealedDirections = () => {
    try {
      const storedValue = window.localStorage.getItem(revealedDirectionsStorageKey);
      const parsedValue: unknown = storedValue ? JSON.parse(storedValue) : [];
      return new Set(
        Array.isArray(parsedValue)
          ? parsedValue.filter((id): id is string => typeof id === "string")
          : [],
      );
    } catch {
      return new Set<string>();
    }
  };

  const initialisePresentationRoute = () => {
    const route = document.querySelector<HTMLElement>("[data-presentation-route]");
    if (!route) return;
    const current = route.dataset.currentStage;
    const currentIndex = stageOrder.indexOf(current ?? "");
    if (currentIndex < 0) return;

    const revealedDirections = readRevealedDirections();

    route.querySelectorAll<HTMLElement>("[data-stage]").forEach((stage, index) => {
      const node = stage.querySelector<HTMLElement>(".presentation-route__node");
      const label = stage.querySelector<HTMLElement>("[data-route-label]");
      if (!node) return;
      const stageId = stage.dataset.stage ?? "";
      const unlocked =
        stageId === "intro" ||
        stageId === "solutions" ||
        revealedDirections.has(stageDirectionIds[stageId] ?? "");
      const isCurrent = index === currentIndex;

      if (unlocked || isCurrent) {
        stage.classList.remove("is-locked", "is-next");
        if (!isCurrent) stage.classList.add("is-complete");
        if (label) label.textContent = stageId.replace("mini-spa", "MINI SPA").toUpperCase();
        node.removeAttribute("aria-disabled");
        node.removeAttribute("tabindex");
        node.removeAttribute("aria-label");
        return;
      }

      stage.classList.remove("is-complete", "is-next");
      stage.classList.add("is-locked");
      if (label) label.textContent = "···";
      node.setAttribute("aria-disabled", "true");
      node.setAttribute("tabindex", "-1");
      node.setAttribute("aria-label", `Etap ${index + 1}: jeszcze nieodkryty`);
    });

    const fill = route.querySelector<HTMLElement>("[data-route-fill]");
    const signal = route.querySelector<HTMLElement>("[data-route-signal]");
    const totalSegments = stageOrder.length - 1;
    const progress = Math.max(0, Math.min(100, (currentIndex / totalSegments) * 100));
    if (fill) fill.style.width = `${progress}%`;
    if (signal) signal.style.left = `${progress}%`;
  };

  document.addEventListener("astro:page-load", initialisePresentationRoute);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initialisePresentationRoute, { once: true });
  } else {
    initialisePresentationRoute();
  }
</script>
