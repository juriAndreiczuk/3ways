---
import IntroThreeScene from "./IntroThreeScene.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<header class="intro-panel">
  <div class="intro-panel__grid" aria-hidden="true"></div>

  <div class="intro-panel__heading relative z-10">
    <div class="intro-panel__eyebrow"><span></span>Interactive web</div>
    <h1>Trzy kierunki. <span class="gradient-text">Szerokie zastosowanie.</span></h1>
  </div>
  <div class="intro-panel__scenes relative z-10" data-collaboration-story>
    <IntroThreeScene />
    <aside class="intro-panel__aside">
      <div class="intro-panel__copy">
        <span class="intro-panel__copy-kicker">NOWA PERSPEKTYWA</span>
        <p>Nowe narzędzia otwierają <em>nowe możliwości</em> w tworzeniu interaktywnych rozwiązań.</p>
        <p>Od prostych elementów po rozbudowane rozwiązania.</p>
      </div>
      <div class="landing-stream" aria-label="Animowane przykłady landing page">
        <div class="landing-stream__track" aria-hidden="true">
          <div class="landing-card landing-card--one"><i></i><b></b><em></em></div>
          <div class="landing-card landing-card--two"><i></i><b></b><em></em></div>
          <div class="landing-card landing-card--three"><i></i><b></b><em></em></div>
        </div>
      </div>
    </aside>
    <a class="intro-panel__next-stage" href={baseUrl + "kierunki"}>
      <span>LISTA ROZWIĄZAŃ</span>
      <i aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M3 9h11M10 5l4 4-4 4" /></svg></i>
    </a>
  </div>
</header>

<script>
  let cleanup: (() => void) | undefined;
  let speedFrame = 0;
  const initialiseStory = () => {
    cleanup?.();
    const story = document.querySelector<HTMLElement>("[data-collaboration-story]");
    if (!story) return;
    const onChange = (event: Event) => {
      const active = (event as CustomEvent<{ active: boolean }>).detail.active;
      story.toggleAttribute("data-collaboration", active);
      const animations = [...story.querySelectorAll<HTMLElement>(".landing-card")]
        .flatMap((card) => card.getAnimations());
      cancelAnimationFrame(speedFrame);
      const started = performance.now();
      const targetRate = active ? 14 / 6 : 1;
      const initialRates = animations.map((animation) => animation.playbackRate);
      const updateRate = (time: number) => {
        const progress = Math.min((time - started) / 700, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        animations.forEach((animation, index) => {
          animation.playbackRate = initialRates[index] + (targetRate - initialRates[index]) * eased;
        });
        if (progress < 1) speedFrame = requestAnimationFrame(updateRate);
      };
      speedFrame = requestAnimationFrame(updateRate);
    };
    story.addEventListener("intro:collaborationchange", onChange);
    cleanup = () => { cancelAnimationFrame(speedFrame); story.removeEventListener("intro:collaborationchange", onChange); };
  };
  document.addEventListener("astro:page-load", initialiseStory);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
