---
import CourseConfigurator from "../components/demo-configurator/CourseConfigurator";
import { courseConfigurator } from "../data/courseConfigurator";
import ViewportWarning from "../components/ViewportWarning.astro";
import PresentationRoute from "../components/PresentationRoute.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={courseConfigurator.config.description} />
    <link rel="icon" href={baseUrl + "favicon.ico"} />
    <title>{courseConfigurator.config.title}</title>
  </head>
  <body>
    <PresentationRoute current="demo" />
    <main>
      <CourseConfigurator client:load />
    </main>
    <ViewportWarning />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 50% -10%, rgba(104, 62, 191, 0.22), transparent 38rem),
      radial-gradient(circle at 90% 80%, rgba(26, 166, 206, 0.07), transparent 30rem),
      #040510;
    color: #f7f5ff;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  main {
    width: min(100% - 2rem, 1160px);
    margin: 0 auto;
    padding: 4rem 0;
  }

</style>
