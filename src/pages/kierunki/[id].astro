---
import DirectionDetailPage from "../../components/DirectionDetailPage.astro";
import type { PresentationStage } from "../../components/PresentationRoute.astro";
import { panels, type DirectionPanel } from "../../data/directions";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return panels.map((panel) => ({ params: { id: panel.id }, props: { panel } }));
}

interface Props {
  panel: DirectionPanel;
}

const { panel } = Astro.props;
const presentationStage: PresentationStage =
  panel.id === "canvas" || panel.id === "islands"
    ? panel.id
    : "mini-spa";
---

<Layout title={`${panel.title} — Interactive Web`} presentationStage={presentationStage}>
  <main class="presentation-page presentation-page--detail" data-page-accent={panel.accent}>
    <div class="ambient ambient--one" aria-hidden="true"></div>
    <div class="ambient ambient--two" aria-hidden="true"></div>

    <section class="presentation-shell">
      <DirectionDetailPage panel={panel} />
    </section>
  </main>
</Layout>
