---
import DirectionSection from "../../components/DirectionSection.astro";
import { directions } from "../../data/directions";
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Wybierz kierunek — Interactive Web">
  <main class="presentation-page presentation-page--directions" data-page-accent="violet">
    <div class="ambient ambient--one" aria-hidden="true"></div>
    <div class="ambient ambient--two" aria-hidden="true"></div>

    <section class="presentation-shell">
      <DirectionSection directions={directions} />
    </section>
  </main>
</Layout>
